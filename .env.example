# Postgres connection. The app keeps its tables in the "saas" schema.
DATABASE_URL=postgresql://user:password@host:5432/db

# Long random string — signs sessions and encrypts stored API keys. Never change it after launch.
APP_SECRET=

# Public URL of the app (used for Shopify OAuth and webhooks), no trailing slash.
APP_URL=https://your-app.vercel.app

# First admin login for /admin (used once, when no admin exists yet).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shopify app from the Shopify Dev Dashboard (for one-click "Connect Shopify").
# Redirect URL to allow in the app: $APP_URL/api/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Protects the daily sync cron (Vercel sends it as a Bearer token).
CRON_SECRET=

# Product name shown in the app.
NEXT_PUBLIC_APP_NAME=Your Company
