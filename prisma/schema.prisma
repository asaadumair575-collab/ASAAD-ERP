// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  name             String
  businessName     String?
  city             String
  phone            String?
  address          String?
  notes            String?
  fixedRate        Boolean  @default(false)
  fixedRateAmount  Float?
  createdAt        DateTime @default(now())
  orders           Order[]
  samples          Sample[]
  productRates     ClientProductRate[]
}

model ClientProductRate {
  id        Int      @id @default(autoincrement())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  rate      Float
  createdAt DateTime @default(now())

  @@unique([clientId, productId])
  @@index([clientId])
}

model Order {
  id             Int         @id @default(autoincrement())
  client         Client      @relation(fields: [clientId], references: [id])
  clientId       Int
  date           DateTime    @default(now())
  description    String?
  purchaseAmount Float
  saleAmount     Float
  discount       Float       @default(0)
  taxPercent     Float       @default(0)
  paymentTerms   String?
  notes          String?     @db.Text
  terms          String?     @db.Text
  paymentStatus  String      @default("UNPAID")
  orderType      String      @default("CREDIT")
  deliveryCharge Float?
  feltColor      String?
  stamp          String?
  packing        String?
  confirmed      Boolean     @default(false)
  dispatched     Boolean     @default(false)
  dispatchedAt   DateTime?
  createdAt      DateTime    @default(now())
  items          OrderItem[]
  payments       Payment[]

  @@index([clientId])
  @@index([confirmed])
  @@index([confirmed, paymentStatus])
  @@index([confirmed, dispatched])
  @@index([paymentStatus])
}

model Payment {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  amount     Float
  method     String   @default("BANK_TRANSFER")
  note       String?
  screenshot String?  @db.Text
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     Int
  product     Product? @relation(fields: [productId], references: [id])
  productId   Int?
  description String
  quantity    Float
  rate        Float
  cost        Float?

  @@index([orderId])
  @@index([productId])
}

model Product {
  id           Int                 @id @default(autoincrement())
  name         String
  cost         Float?
  createdAt    DateTime            @default(now())
  orderItems   OrderItem[]
  clientRates  ClientProductRate[]
}

model BusinessProfile {
  id                 Int     @id @default(autoincrement())
  name               String
  phone              String?
  address            String?
  logo               String? @db.Text
  bankName           String?
  bankAccountTitle   String?
  bankAccountNumber  String?
}

model DraftOrder {
  id           Int      @id @default(autoincrement())
  customerName String
  phone        String?
  address      String?
  city         String?
  items        String?
  advanceAmount Float   @default(200)
  confirmed    Boolean  @default(false)
  confirmedAt  DateTime?
  createdBy    User?    @relation(fields: [createdById], references: [id])
  createdById  Int?
  createdAt    DateTime @default(now())

  @@index([createdById])
  @@index([confirmed])
}

model CostRate {
  id            Int      @id @default(autoincrement())
  costPerDozen  Float
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
}

model User {
  id                   Int                  @id @default(autoincrement())
  username             String               @unique
  passwordHash         String
  displayName          String?
  isAdmin              Boolean              @default(false)
  permissions          Json                 @default("{}")
  apiToken             String?              @unique
  fcmToken             String?
  createdAt            DateTime             @default(now())
  empCommissionEntries EmpCommissionEntry[]
  empWithdrawals       EmpWithdrawal[]
  empPerformances      EmpPerformance[]
  shifts               EmployeeShift[]
  tasksAssigned        EmployeeTask[]       @relation("TaskAssignee")
  tasksGiven           EmployeeTask[]       @relation("TaskAssigner")
  leadsContacted       Lead[]               @relation("LeadContactedBy")
  retailOrders         RetailOrder[]
  bugReports           BugReport[]
  messagesSent         Message[]        @relation("MessagesSent")
  messagesReceived     Message[]        @relation("MessagesReceived")
  reorderCampaigns     ReorderCampaign[]
  reorderCalls         ReorderLead[]    @relation("ReorderLeadCalledBy")
  reorderCallLogs      ReorderCallLog[] @relation("ReorderCallLogCalledBy")
  retailFollowupLogs   RetailFollowupLog[] @relation("RetailFollowupLogCalledBy")
  pushSubscriptions    PushSubscription[]
  complaints           Complaint[]
  complaintMessages    ComplaintMessage[]
  draftOrders          DraftOrder[]
  phoneCallLogs        PhoneCallLog[]
  weightVerifications  WeightVerification[]
}

model EmpCommissionEntry {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  date       DateTime @db.Date
  orders     Int
  note       String?
  status     String   @default("pending")
  adminNote  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([date])
}

model EmpWithdrawal {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  amount      Float
  note        String?
  date        DateTime @db.Date
  status      String   @default("approved")
  adminNote   String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model CommissionRate {
  id            Int      @id @default(autoincrement())
  ratePerDozen  Float
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
}

model CommissionOrder {
  id           Int       @id @default(autoincrement())
  orderFor     String
  date         DateTime  @default(now())
  dozens       Float
  notes        String?
  dispatched   Boolean   @default(false)
  dispatchedAt DateTime?
  createdAt    DateTime  @default(now())
}

model Sample {
  id           Int       @id @default(autoincrement())
  client       Client?   @relation(fields: [clientId], references: [id])
  clientId     Int?
  lead         Lead?     @relation(fields: [leadId], references: [id])
  leadId       Int?
  description  String
  dateSent     DateTime  @default(now())
  status       String    @default("PENDING")
  response     String?   @db.Text
  responseDate DateTime?
  createdAt    DateTime  @default(now())

  @@index([clientId])
  @@index([leadId])
}

model RetailCustomer {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  name      String
  phone     String?
  city      String?
  address   String?
  notes     String?
  createdAt DateTime      @default(now())
  orders    RetailOrder[]
}

model RetailOrder {
  id               Int              @id @default(autoincrement())
  retailCustomer   RetailCustomer?  @relation(fields: [retailCustomerId], references: [id])
  retailCustomerId Int?
  customerName     String
  phone            String?
  city             String?
  address          String?
  totalAmount      Float
  deliveryCharge   Float            @default(0)
  courierCharge        Float            @default(0)
  returnDeliveryCost   Float            @default(0)
  status               String           @default("PENDING")
  dispatched       Boolean          @default(false)
  dispatchedAt     DateTime?
  trackingNumber   String?
  trackingSetAt    DateTime?
  exportedAt       DateTime?
  notes            String?
  date             DateTime         @default(now())
  createdAt        DateTime         @default(now())
  createdBy        User?            @relation(fields: [createdByUserId], references: [id])
  createdByUserId  Int?
  items            RetailOrderItem[]
  payments         RetailPayment[]

  @@index([retailCustomerId])
  @@index([createdByUserId])
  @@index([status])
}

model RetailOrderItem {
  id          Int         @id @default(autoincrement())
  order       RetailOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     Int
  description String
  quantity    Float
  rate        Float
  costPrice   Float       @default(0)

  @@index([orderId])
}

model RetailPayment {
  id         Int         @id @default(autoincrement())
  order      RetailOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  amount     Float
  channel    String      @default("BANK")
  note       String?
  screenshot String?
  date       DateTime    @default(now())

  @@index([orderId])
}

model Lead {
  id              Int       @id @default(autoincrement())
  shopNumber      String
  name            String?
  city            String
  phone           String?
  status          String    @default("NEW")
  notes           String?   @db.Text
  contactedById   Int?
  contactedBy     User?     @relation("LeadContactedBy", fields: [contactedById], references: [id])
  contactedAt     DateTime?
  createdAt       DateTime  @default(now())
  samples         Sample[]

  @@index([contactedById, contactedAt])
}

model EcomOrder {
  id              Int             @id @default(autoincrement())
  date            DateTime        @default(now())
  customerName    String
  phone           String?
  city            String?
  notes           String?
  totalAmount     Float
  status          String          @default("PENDING")
  returned        Boolean         @default(false)
  shippingCost    Float           @default(0)
  adCost          Float           @default(0)
  packagingCost   Float           @default(0)
  returnCost      Float           @default(0)
  address         String?
  trackingNumber  String?
  dispatchedAt    DateTime?
  shopifyOrderId  String?
  draft           Boolean         @default(false)
  draftStatus     String?
  confirmedAt     DateTime?
  source          String?
  createdAt       DateTime        @default(now())
  items         EcomOrderItem[]
  payments      EcomPayment[]
  statusLogs    EcomOrderStatusLog[]
}

model EcomOrderStatusLog {
  id        Int       @id @default(autoincrement())
  order     EcomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  status    String
  createdAt DateTime  @default(now())

  @@index([orderId])
}

model EcomOrderItem {
  id          Int        @id @default(autoincrement())
  order       EcomOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     Int
  description String
  quantity    Float
  packSize    Int        @default(12)
  rate        Float

  @@index([orderId])
}

model EcomPayment {
  id      Int       @id @default(autoincrement())
  order   EcomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId Int
  amount  Float
  note    String?
  date    DateTime  @default(now())

  @@index([orderId])
}

model CprBatch {
  id           Int      @id @default(autoincrement())
  appliedAt    DateTime @default(now())
  fileCount    Int      @default(1)
  payments     Int
  returned     Int
  notFound     Int
  totalSettled Float
}

model EmpPerformance {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id])
  userId        Int
  date          DateTime @db.Date
  calls         Int      @default(0)
  confirmations Int      @default(0)
  newOrders     Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([date])
}

model PerformanceTarget {
  id            Int      @id @default(autoincrement())
  calls         Int      @default(0)
  confirmations Int      @default(0)
  newOrders     Int      @default(0)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
}

model AppSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text
}

model Message {
  id         Int      @id @default(autoincrement())
  sender     User     @relation("MessagesSent", fields: [senderId], references: [id])
  senderId   Int
  receiver   User     @relation("MessagesReceived", fields: [receiverId], references: [id])
  receiverId Int
  body       String   @db.Text
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([receiverId])
  @@index([senderId])
  @@index([receiverId, readAt])
}

model BugReport {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  page        String?
  status      String   @default("OPEN")
  adminNote   String?
  reportedBy  User?    @relation(fields: [reportedById], references: [id])
  reportedById Int?
  createdAt   DateTime @default(now())

  @@index([reportedById])
  @@index([status])
}


model EcomExpense {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  category  String
  type      String   @default("VARIABLE")
  amount    Float
  note      String?
  createdAt DateTime @default(now())
}

model ReorderCampaign {
  id                Int                  @id @default(autoincrement())
  name              String
  createdAt         DateTime             @default(now())
  createdBy         User?                @relation(fields: [createdById], references: [id])
  createdById       Int?
  isRetailFollowup  Boolean              @default(false)
  isActive          Boolean              @default(true)
  sentForAudit      Boolean              @default(false)
  auditRequestedAt  DateTime?
  auditFeedback     String?
  auditReturnedAt   DateTime?
  auditLogs         CampaignAuditLog[]
  leads             ReorderLead[]
}

model CampaignAuditLog {
  id           Int             @id @default(autoincrement())
  campaign     ReorderCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   Int
  sentAt       DateTime
  returnedAt   DateTime?
  feedback     String?
  roundStats   Json?
  createdAt    DateTime        @default(now())
  @@index([campaignId])
}

model ReorderLead {
  id               Int               @id @default(autoincrement())
  campaign         ReorderCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId       Int
  customerName     String
  phone            String
  email            String?
  address          String?
  city             String?
  prevItem         String?
  status           String            @default("PENDING")
  callNote         String?
  followUpDate     DateTime?         @db.Date
  calledAt         DateTime?
  calledBy         User?             @relation("ReorderLeadCalledBy", fields: [calledById], references: [id])
  calledById       Int?
  createdAt              DateTime             @default(now())
  postexTrackingNumber   String?
  activeOnApp            Boolean              @default(false)
  callLogs               ReorderCallLog[]
  callAttempts           ReorderCallAttempt[]
  callAborts             ReorderCallAbort[]

  @@index([campaignId])
  @@index([campaignId, status])
  @@index([calledById])
  @@index([status])
  @@index([activeOnApp])
}

model ReorderCallLog {
  id          Int         @id @default(autoincrement())
  lead        ReorderLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      Int
  status      String
  callNote    String?
  calledAt    DateTime    @default(now())
  calledBy    User        @relation("ReorderCallLogCalledBy", fields: [calledById], references: [id])
  calledById  Int
  attemptedAt DateTime?
  openCount   Int         @default(0)

  @@index([leadId])
  @@index([calledById])
}

model ReorderCallAttempt {
  id       Int         @id @default(autoincrement())
  lead     ReorderLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId   Int
  userId   Int
  openedAt DateTime    @default(now())

  @@index([leadId])
}

model ReorderCallAbort {
  id        Int         @id @default(autoincrement())
  lead      ReorderLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    Int
  userId    Int
  abortedAt DateTime    @default(now())

  @@index([leadId])
}

model RetailFollowupLog {
  id         Int      @id @default(autoincrement())
  phone      String
  status     String
  note       String?
  calledAt   DateTime @default(now())
  calledBy   User     @relation("RetailFollowupLogCalledBy", fields: [calledById], references: [id])
  calledById Int
}

model Complaint {
  id              Int      @id @default(autoincrement())
  complaintType   String   @default("INTERNAL")  // INTERNAL | CUSTOMER
  priority        String   @default("MEDIUM")    // LOW | MEDIUM | HIGH | URGENT
  title           String
  description     String   @db.Text
  category        String   @default("GENERAL")
  status          String   @default("OPEN")
  adminNote       String?  @db.Text
  metadata        Json?
  // customer complaint fields
  customerName    String?
  customerPhone   String?
  orderId         String?
  submittedBy     User?    @relation(fields: [submittedById], references: [id])
  submittedById   Int?
  createdAt       DateTime @default(now())

  messages       ComplaintMessage[]

  @@index([submittedById])
  @@index([status])
  @@index([complaintType])
  @@index([priority])
}

model ComplaintMessage {
  id          Int      @id @default(autoincrement())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  complaintId Int
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  message     String   @db.Text
  createdAt   DateTime @default(now())

  @@index([complaintId])
}

model PhoneCallLog {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  phoneNumber  String
  contactName  String?
  duration     Int      // seconds — talk time, only set when the call connected
  ringDuration Int      @default(0) // seconds — how long it rang before a non-connected call ended
  callType     String   // INCOMING | OUTGOING | MISSED
  calledAt     DateTime
  synced       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([userId, phoneNumber, calledAt])
  @@index([userId])
  @@index([userId, calledAt])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Employee Work System ───────────────────────────────────────────────────

model EmployeeShift {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([userId])
  @@index([userId, startedAt])
}

model EmployeeTask {
  id          Int       @id @default(autoincrement())
  assignedTo  User      @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedToId Int
  assignedBy  User      @relation("TaskAssigner", fields: [assignedById], references: [id])
  assignedById Int
  title       String
  description String?
  targetValue Int
  unit        String    // e.g. "calls", "leads", "orders"
  progress    Int       @default(0)
  metric      String?   // REORDER_CALLS | RETAIL_ORDERS | null = manual
  date        DateTime  // which day this task is for
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([assignedToId])
  @@index([assignedToId, date])
}

// ── Calling Module ─────────────────────────────────────────────────────────


model RetailExportLog {
  id         Int      @id @default(autoincrement())
  date       String
  exportedAt DateTime @default(now())

  @@index([date])
}

model WebsiteVisit {
  id        Int      @id @default(autoincrement())
  visitorId String
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
}

model WeightVerification {
  id             Int      @id @default(autoincrement())
  trackingNumber String
  photo          String   @db.Text
  verifiedBy     User?    @relation(fields: [verifiedById], references: [id])
  verifiedById   Int?
  createdAt      DateTime @default(now())

  @@index([trackingNumber])
  @@index([createdAt])
}
