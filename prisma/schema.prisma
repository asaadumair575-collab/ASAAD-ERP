// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id           Int      @id @default(autoincrement())
  name         String
  businessName String?
  city         String
  phone        String?
  address      String?
  notes        String?
  createdAt    DateTime @default(now())
  orders       Order[]
  samples      Sample[]
}

model Order {
  id             Int         @id @default(autoincrement())
  client         Client      @relation(fields: [clientId], references: [id])
  clientId       Int
  date           DateTime    @default(now())
  description    String?
  purchaseAmount Float
  saleAmount     Float
  discount       Float       @default(0)
  taxPercent     Float       @default(0)
  paymentTerms   String?
  notes          String?     @db.Text
  terms          String?     @db.Text
  paymentStatus  String      @default("UNPAID")
  orderType      String      @default("CREDIT")
  deliveryCharge Float?
  confirmed      Boolean     @default(false)
  dispatched     Boolean     @default(false)
  dispatchedAt   DateTime?
  createdAt      DateTime    @default(now())
  items          OrderItem[]
  payments       Payment[]
}

model Payment {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  amount     Float
  method     String   @default("BANK_TRANSFER")
  note       String?
  screenshot String?  @db.Text
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     Int
  product     Product? @relation(fields: [productId], references: [id])
  productId   Int?
  description String
  quantity    Float
  rate        Float
  cost        Float?
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  cost       Float?
  createdAt  DateTime    @default(now())
  orderItems OrderItem[]
}

model BusinessProfile {
  id      Int     @id @default(autoincrement())
  name    String
  phone   String?
  address String?
  logo    String? @db.Text
}

model CostRate {
  id            Int      @id @default(autoincrement())
  costPerDozen  Float
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
}

model User {
  id                   Int                  @id @default(autoincrement())
  username             String               @unique
  passwordHash         String
  displayName          String?
  isAdmin              Boolean              @default(false)
  permissions          Json                 @default("{}")
  createdAt            DateTime             @default(now())
  empCommissionEntries EmpCommissionEntry[]
  empPerformances      EmpPerformance[]
  retailOrders         RetailOrder[]
  bugReports           BugReport[]
  messagesSent         Message[]        @relation("MessagesSent")
  messagesReceived     Message[]        @relation("MessagesReceived")
  reorderCampaigns     ReorderCampaign[]
  reorderCalls         ReorderLead[]    @relation("ReorderLeadCalledBy")
  reorderCallLogs      ReorderCallLog[] @relation("ReorderCallLogCalledBy")
  retailFollowupLogs   RetailFollowupLog[] @relation("RetailFollowupLogCalledBy")
}

model EmpCommissionEntry {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  date       DateTime @db.Date
  orders     Int
  note       String?
  status     String   @default("pending")
  adminNote  String?
  createdAt  DateTime @default(now())
}

model CommissionRate {
  id            Int      @id @default(autoincrement())
  ratePerDozen  Float
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
}

model CommissionOrder {
  id           Int       @id @default(autoincrement())
  orderFor     String
  date         DateTime  @default(now())
  dozens       Float
  notes        String?
  dispatched   Boolean   @default(false)
  dispatchedAt DateTime?
  createdAt    DateTime  @default(now())
}

model Sample {
  id           Int       @id @default(autoincrement())
  client       Client?   @relation(fields: [clientId], references: [id])
  clientId     Int?
  lead         Lead?     @relation(fields: [leadId], references: [id])
  leadId       Int?
  description  String
  dateSent     DateTime  @default(now())
  status       String    @default("PENDING")
  response     String?   @db.Text
  responseDate DateTime?
  createdAt    DateTime  @default(now())
}

model RetailCustomer {
  id        Int           @id @default(autoincrement())
  name      String
  phone     String?
  city      String?
  address   String?
  notes     String?
  createdAt DateTime      @default(now())
  orders    RetailOrder[]
}

model RetailOrder {
  id               Int              @id @default(autoincrement())
  retailCustomer   RetailCustomer?  @relation(fields: [retailCustomerId], references: [id])
  retailCustomerId Int?
  customerName     String
  phone            String?
  city             String?
  totalAmount      Float
  deliveryCharge   Float            @default(0)
  courierCharge        Float            @default(0)
  returnDeliveryCost   Float            @default(0)
  status               String           @default("PENDING")
  dispatched       Boolean          @default(false)
  dispatchedAt     DateTime?
  trackingNumber   String?
  notes            String?
  date             DateTime         @default(now())
  createdAt        DateTime         @default(now())
  createdBy        User?            @relation(fields: [createdByUserId], references: [id])
  createdByUserId  Int?
  items            RetailOrderItem[]
  payments         RetailPayment[]
}

model RetailOrderItem {
  id          Int         @id @default(autoincrement())
  order       RetailOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     Int
  description String
  quantity    Float
  rate        Float
  costPrice   Float       @default(0)
}

model RetailPayment {
  id         Int         @id @default(autoincrement())
  order      RetailOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  amount     Float
  note       String?
  screenshot String?
  date       DateTime    @default(now())
}

model Lead {
  id         Int      @id @default(autoincrement())
  shopNumber String
  name       String?
  city       String
  phone      String?
  status     String   @default("NEW")
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  samples    Sample[]
}

model EcomOrder {
  id              Int             @id @default(autoincrement())
  date            DateTime        @default(now())
  customerName    String
  phone           String?
  city            String?
  notes           String?
  totalAmount     Float
  status          String          @default("PENDING")
  returned        Boolean         @default(false)
  shippingCost    Float           @default(0)
  adCost          Float           @default(0)
  packagingCost   Float           @default(0)
  returnCost      Float           @default(0)
  address         String?
  trackingNumber  String?
  shopifyOrderId  String?
  createdAt       DateTime        @default(now())
  items         EcomOrderItem[]
  payments      EcomPayment[]
}

model EcomOrderItem {
  id          Int        @id @default(autoincrement())
  order       EcomOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     Int
  description String
  quantity    Float
  packSize    Int        @default(12)
  rate        Float
}

model EcomPayment {
  id      Int       @id @default(autoincrement())
  order   EcomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId Int
  amount  Float
  note    String?
  date    DateTime  @default(now())
}

model CprBatch {
  id           Int      @id @default(autoincrement())
  appliedAt    DateTime @default(now())
  fileCount    Int      @default(1)
  payments     Int
  returned     Int
  notFound     Int
  totalSettled Float
}

model EmpPerformance {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id])
  userId        Int
  date          DateTime @db.Date
  calls         Int      @default(0)
  confirmations Int      @default(0)
  newOrders     Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
}

model PerformanceTarget {
  id            Int      @id @default(autoincrement())
  calls         Int      @default(0)
  confirmations Int      @default(0)
  newOrders     Int      @default(0)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
}

model AppSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text
}

model Message {
  id         Int      @id @default(autoincrement())
  sender     User     @relation("MessagesSent", fields: [senderId], references: [id])
  senderId   Int
  receiver   User     @relation("MessagesReceived", fields: [receiverId], references: [id])
  receiverId Int
  body       String   @db.Text
  readAt     DateTime?
  createdAt  DateTime @default(now())
}

model BugReport {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  page        String?
  status      String   @default("OPEN")
  adminNote   String?
  reportedBy  User?    @relation(fields: [reportedById], references: [id])
  reportedById Int?
  createdAt   DateTime @default(now())
}


model EcomExpense {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  category  String
  type      String   @default("VARIABLE")
  amount    Float
  note      String?
  createdAt DateTime @default(now())
}

model ReorderCampaign {
  id                Int           @id @default(autoincrement())
  name              String
  createdAt         DateTime      @default(now())
  createdBy         User?         @relation(fields: [createdById], references: [id])
  createdById       Int?
  isRetailFollowup  Boolean       @default(false)
  isActive          Boolean       @default(true)
  leads             ReorderLead[]
}

model ReorderLead {
  id               Int               @id @default(autoincrement())
  campaign         ReorderCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId       Int
  customerName     String
  phone            String
  email            String?
  address          String?
  city             String?
  prevItem         String?
  status           String            @default("PENDING")
  callNote         String?
  followUpDate     DateTime?         @db.Date
  calledAt         DateTime?
  calledBy         User?             @relation("ReorderLeadCalledBy", fields: [calledById], references: [id])
  calledById       Int?
  createdAt        DateTime             @default(now())
  callLogs         ReorderCallLog[]
  callAttempts     ReorderCallAttempt[]
}

model ReorderCallLog {
  id          Int         @id @default(autoincrement())
  lead        ReorderLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      Int
  status      String
  callNote    String?
  calledAt    DateTime    @default(now())
  calledBy    User        @relation("ReorderCallLogCalledBy", fields: [calledById], references: [id])
  calledById  Int
  attemptedAt DateTime?
  openCount   Int         @default(0)
}

model ReorderCallAttempt {
  id       Int         @id @default(autoincrement())
  lead     ReorderLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId   Int
  userId   Int
  openedAt DateTime    @default(now())
}

model RetailFollowupLog {
  id         Int      @id @default(autoincrement())
  phone      String
  status     String
  note       String?
  calledAt   DateTime @default(now())
  calledBy   User     @relation("RetailFollowupLogCalledBy", fields: [calledById], references: [id])
  calledById Int
}

// ── Calling Module ─────────────────────────────────────────────────────────
