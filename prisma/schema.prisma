// E-commerce operations SaaS: each Tenant is one store that bought (or is
// trialling) the software. Lives in its own Postgres schema ("saas", set by
// the connection — see prisma.config.ts and src/lib/db.ts) so it never mixes
// with tables left over from the previous app.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  TRIAL
  STARTER
  GROWTH
  PRO
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  OWNER
  STAFF
}

enum Courier {
  POSTEX
  LEOPARDS
  TCS
  DEMO
}

enum OrderSource {
  SHOPIFY
  MANUAL
}

enum PaymentMethod {
  COD
  PREPAID
}

enum OrderStatus {
  NEW
  CONFIRMED
  BOOKED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

enum ShipmentStatus {
  BOOKED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Tenant {
  id        Int          @id @default(autoincrement())
  name      String
  plan      Plan         @default(TRIAL)
  status    TenantStatus @default(ACTIVE)
  // null = no end date (paid / unlimited)
  expiresAt DateTime?
  isDemo    Boolean      @default(false)
  notes     String?
  // Shown on packing slips and in WhatsApp messages
  phone     String?
  address   String?
  createdAt DateTime     @default(now())

  users     User[]
  blocked   BlockedPhone[]
  expenses  Expense[]
  shopify   ShopifyConnection?
  couriers  CourierAccount[]
  products  Product[]
  customers Customer[]
  orders    Order[]
  shipments Shipment[]
  activity  Activity[]
}

model User {
  id             Int       @id @default(autoincrement())
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       Int
  name           String
  email          String    @unique
  passwordHash   String
  role           Role      @default(STAFF)
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId])
}

model ShopifyConnection {
  id          Int       @id @default(autoincrement())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    Int       @unique
  shopDomain  String    @unique
  // Encrypted with APP_SECRET (src/lib/crypto.ts)
  accessToken String
  // Dev Dashboard apps: encrypted {clientId, clientSecret}; the access token
  // is fetched with the client credentials grant and refreshed every 24 h.
  clientCreds    String?
  tokenExpiresAt DateTime?
  scope       String?
  method      String    @default("OAUTH")
  connectedAt DateTime  @default(now())
  lastSyncAt  DateTime?
  syncError   String?
}

model CourierAccount {
  id          Int      @id @default(autoincrement())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    Int
  courier     Courier
  // Encrypted JSON of the courier's credentials and pickup settings
  credentials String
  label       String?
  createdAt   DateTime @default(now())

  @@unique([tenantId, courier])
}

model Product {
  id               Int      @id @default(autoincrement())
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         Int
  shopifyVariantId String?
  shopifyProductId String?
  title            String
  variantTitle     String?
  sku              String?
  price            Float    @default(0)
  cost             Float?
  stock            Int      @default(0)
  lowStockAt       Int      @default(10)
  imageUrl         String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  items OrderItem[]

  @@unique([tenantId, shopifyVariantId])
  @@index([tenantId])
}

model Customer {
  id                Int      @id @default(autoincrement())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId          Int
  shopifyCustomerId String?
  name              String
  phone             String?
  email             String?
  city              String?
  createdAt         DateTime @default(now())

  orders Order[]

  @@unique([tenantId, shopifyCustomerId])
  @@index([tenantId, phone])
}

model Order {
  id             Int           @id @default(autoincrement())
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       Int
  source         OrderSource   @default(MANUAL)
  shopifyOrderId String?
  number         String
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId     Int?
  customerName   String
  phone          String?
  email          String?
  address        String?
  city           String?
  subtotal       Float         @default(0)
  discount       Float         @default(0)
  shippingFee    Float         @default(0)
  total          Float         @default(0)
  paymentMethod  PaymentMethod @default(COD)
  status         OrderStatus   @default(NEW)
  notes          String?
  placedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    OrderItem[]
  shipment Shipment?
  activity Activity[]

  @@unique([tenantId, shopifyOrderId])
  @@index([tenantId, status])
  @@index([tenantId, placedAt])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId Int?
  title     String
  sku       String?
  qty       Int
  price     Float

  @@index([orderId])
}

model Shipment {
  id             Int            @id @default(autoincrement())
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        Int            @unique
  courier        Courier
  trackingNumber String
  status         ShipmentStatus @default(BOOKED)
  courierStatus  String?
  codAmount      Float          @default(0)
  courierCharge  Float          @default(0)
  weightKg       Float          @default(0.5)
  slipUrl        String?
  bookedAt       DateTime       @default(now())
  deliveredAt    DateTime?
  returnedAt     DateTime?
  lastCheckedAt  DateTime?
  codRemitted    Boolean        @default(false)
  remittedAt     DateTime?

  @@index([tenantId, status])
  @@index([tenantId, courier])
}

model Activity {
  id        Int      @id @default(autoincrement())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Int
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int?
  message   String
  by        String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([tenantId, createdAt])
}

// Phone numbers the store refuses to ship to (fake orders, repeat returns).
model BlockedPhone {
  id        Int      @id @default(autoincrement())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Int
  phone     String
  reason    String?
  by        String?
  createdAt DateTime @default(now())

  @@unique([tenantId, phone])
}

// Running costs (ads, packaging, salaries…) used for net profit.
model Expense {
  id        Int      @id @default(autoincrement())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Int
  date      DateTime
  category  String
  amount    Float
  note      String?
  by        String?
  createdAt DateTime @default(now())

  @@index([tenantId, date])
}
