// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id           Int      @id @default(autoincrement())
  name         String
  businessName String?
  city         String
  phone        String?
  address      String?
  notes        String?
  createdAt    DateTime @default(now())
  orders       Order[]
  samples      Sample[]
}

model Order {
  id             Int         @id @default(autoincrement())
  client         Client      @relation(fields: [clientId], references: [id])
  clientId       Int
  date           DateTime    @default(now())
  description    String?
  purchaseAmount Float
  saleAmount     Float
  discount       Float       @default(0)
  taxPercent     Float       @default(0)
  paymentTerms   String?
  notes          String?     @db.Text
  terms          String?     @db.Text
  paymentStatus  String      @default("UNPAID")
  orderType      String      @default("CREDIT")
  deliveryCharge Float?
  confirmed      Boolean     @default(false)
  dispatched     Boolean     @default(false)
  dispatchedAt   DateTime?
  createdAt      DateTime    @default(now())
  items          OrderItem[]
  payments       Payment[]
}

model Payment {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  amount     Float
  method     String   @default("BANK_TRANSFER")
  note       String?
  screenshot String?  @db.Text
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     Int
  product     Product? @relation(fields: [productId], references: [id])
  productId   Int?
  description String
  quantity    Float
  rate        Float
  cost        Float?
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  cost       Float?
  createdAt  DateTime    @default(now())
  orderItems OrderItem[]
}

model BusinessProfile {
  id      Int     @id @default(autoincrement())
  name    String
  phone   String?
  address String?
  logo    String? @db.Text
}

model CostRate {
  id            Int      @id @default(autoincrement())
  costPerDozen  Float
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
}

model User {
  id                   Int                  @id @default(autoincrement())
  username             String               @unique
  passwordHash         String
  displayName          String?
  isAdmin              Boolean              @default(false)
  permissions          Json                 @default("{}")
  createdAt            DateTime             @default(now())
  empCommissionEntries EmpCommissionEntry[]
}

model EmpCommissionEntry {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  date       DateTime @db.Date
  orders     Int
  note       String?
  status     String   @default("pending")
  adminNote  String?
  createdAt  DateTime @default(now())
}

model CommissionRate {
  id            Int      @id @default(autoincrement())
  ratePerDozen  Float
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
}

model CommissionOrder {
  id           Int       @id @default(autoincrement())
  orderFor     String
  date         DateTime  @default(now())
  dozens       Float
  notes        String?
  dispatched   Boolean   @default(false)
  dispatchedAt DateTime?
  createdAt    DateTime  @default(now())
}

model Sample {
  id           Int       @id @default(autoincrement())
  client       Client?   @relation(fields: [clientId], references: [id])
  clientId     Int?
  lead         Lead?     @relation(fields: [leadId], references: [id])
  leadId       Int?
  description  String
  dateSent     DateTime  @default(now())
  status       String    @default("PENDING")
  response     String?   @db.Text
  responseDate DateTime?
  createdAt    DateTime  @default(now())
}

model RetailCustomer {
  id        Int           @id @default(autoincrement())
  name      String
  phone     String?
  city      String?
  address   String?
  notes     String?
  createdAt DateTime      @default(now())
  orders    RetailOrder[]
}

model RetailOrder {
  id               Int              @id @default(autoincrement())
  retailCustomer   RetailCustomer?  @relation(fields: [retailCustomerId], references: [id])
  retailCustomerId Int?
  customerName     String
  phone            String?
  city             String?
  totalAmount      Float
  deliveryCharge   Float            @default(0)
  courierCharge        Float            @default(0)
  returnDeliveryCost   Float            @default(0)
  status               String           @default("PENDING")
  dispatched       Boolean          @default(false)
  dispatchedAt     DateTime?
  notes            String?
  date             DateTime         @default(now())
  createdAt        DateTime         @default(now())
  items            RetailOrderItem[]
  payments         RetailPayment[]
}

model RetailOrderItem {
  id          Int         @id @default(autoincrement())
  order       RetailOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     Int
  description String
  quantity    Float
  rate        Float
  costPrice   Float       @default(0)
}

model RetailPayment {
  id         Int         @id @default(autoincrement())
  order      RetailOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  amount     Float
  note       String?
  screenshot String?
  date       DateTime    @default(now())
}

model Lead {
  id         Int      @id @default(autoincrement())
  shopNumber String
  name       String?
  city       String
  phone      String?
  status     String   @default("NEW")
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  samples    Sample[]
}

model EcomOrder {
  id            Int             @id @default(autoincrement())
  date          DateTime        @default(now())
  customerName  String
  phone         String?
  city          String?
  notes         String?
  totalAmount   Float
  status        String          @default("PENDING")
  shippingCost  Float           @default(0)
  adCost        Float           @default(0)
  packagingCost Float           @default(0)
  returnCost    Float           @default(0)
  createdAt     DateTime        @default(now())
  items         EcomOrderItem[]
  payments      EcomPayment[]
}

model EcomOrderItem {
  id          Int        @id @default(autoincrement())
  order       EcomOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     Int
  description String
  quantity    Float
  rate        Float
}

model EcomPayment {
  id      Int       @id @default(autoincrement())
  order   EcomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId Int
  amount  Float
  note    String?
  date    DateTime  @default(now())
}
